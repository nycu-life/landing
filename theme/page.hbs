{{!< default}}
{{#contentFor "lang"}}[[lang]]{{/contentFor}}
{{#contentFor "header"}}{{> "[[locale]]/header"}}{{/contentFor}}
{{#contentFor "footer"}}{{> "[[locale]]/footer"}}{{/contentFor}}
{{#post}}
<article class="page article-page {{post_class}}">{{#if @page.show_title_and_feature_image}}<header class="article-head"><h1 class="article-title">{{title}}</h1>{{#if custom_excerpt}}<p class="article-lede">{{custom_excerpt}}</p>{{/if}}</header>{{#if feature_image}}<img class="article-cover" src="{{img_url feature_image size='xl'}}" alt="{{feature_image_alt}}">{{/if}}{{/if}}<div class="prose gh-content">{{content}}</div></article>
{{/post}}
