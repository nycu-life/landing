{{!< default}}
{{#contentFor "lang"}}zh-tw{{/contentFor}}
{{#contentFor "header"}}{{> "zh-tw/header"}}{{/contentFor}}
{{#contentFor "footer"}}{{> "zh-tw/footer"}}{{/contentFor}}
{{#post}}
<article class="page article-page {{post_class}}">
    <header class="article-head"><time datetime="{{date format='YYYY-MM-DD'}}">{{date format="YYYY / MM / DD"}}</time><h1 class="article-title">{{title}}</h1>{{#if custom_excerpt}}<p class="article-lede">{{custom_excerpt}}</p>{{/if}}{{#if tags}}<p class="article-tags">{{#foreach tags}}<a class="article-tag" href="{{url}}">{{name}}</a>{{/foreach}}</p>{{/if}}</header>
    {{#if feature_image}}<figure><img class="article-cover" src="{{img_url feature_image size='xl'}}" alt="{{feature_image_alt}}">{{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}</figure>{{/if}}
    <div class="prose gh-content">{{content}}</div>
    <nav class="post-nav" aria-label="文章導覽">{{#prev_post}}<a class="post-nav-link" href="{{url}}" rel="prev"><span class="post-nav-dir">← 上一篇</span><span class="post-nav-title">{{title}}</span></a>{{/prev_post}}{{#next_post}}<a class="post-nav-link older" href="{{url}}" rel="next"><span class="post-nav-dir">下一篇 →</span><span class="post-nav-title">{{title}}</span></a>{{/next_post}}</nav>
</article>
{{/post}}
