{{!< default}}
{{#contentFor "lang"}}[[lang]]{{/contentFor}}
{{#contentFor "header"}}{{> "[[locale]]/header"}}{{/contentFor}}
{{#contentFor "footer"}}{{> "[[locale]]/footer"}}{{/contentFor}}
<div class="page devlog-page">
    <header class="page-head"><span class="devlog-eyebrow">NYCU LIFE / [[section]]</span><h1 class="page-title">[[sectionTitle]]</h1><p class="page-lede">[[sectionDescription]]</p></header>
    <div class="native-post-grid">{{#foreach posts}}{{> "card"}}{{else}}<p>{{copy 'devlog_empty_body'}}</p>{{/foreach}}</div>
    {{pagination}}
</div>
