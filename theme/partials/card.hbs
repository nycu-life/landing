<article class='native-post-card {{post_class}}'>
	<a href='{{url}}'>
		{{#if feature_image}}
			{{! Ghost rasterises SVG without the site's CJK fonts, so SVG covers stay vector. }}
			{{#match feature_image '~$' '.svg'}}
				<img
					class='native-post-cover'
					src='{{feature_image}}'
					alt='{{feature_image_alt}}'
					loading='lazy'
					decoding='async'
					width='600'
					height='338'
				/>
			{{else}}
				<img
					class='native-post-cover'
					srcset='{{img_url feature_image size="s" format="webp"}} 320w, {{img_url feature_image size="m" format="webp"}} 600w, {{img_url feature_image size="l" format="webp"}} 960w'
					sizes='(max-width: 767px) calc(100vw - 2.5rem), (max-width: 1100px) 46vw, 380px'
					src='{{img_url feature_image size="m" format="webp"}}'
					alt='{{feature_image_alt}}'
					loading='lazy'
					decoding='async'
					width='600'
					height='338'
				/>
			{{/match}}
		{{else}}
			<span class='native-post-cover native-post-cover-fallback' aria-hidden='true'>
				<span>{{#if primary_tag}}{{primary_tag.name}}{{else}}NYCU LIFE{{/if}}</span>
			</span>
		{{/if}}
		<div class='native-post-copy'>
			<time datetime='{{date format='YYYY-MM-DD'}}'>{{date format='YYYY / MM / DD'}}</time>
			<h2>{{title}}</h2>
			<p>{{excerpt words='35'}}</p>
			{{#if tags}}<span class='post-chips'>{{#foreach tags}}<span
						class='post-chip'
					>{{name}}</span>{{/foreach}}</span>{{/if}}
		</div>
	</a>
</article>
