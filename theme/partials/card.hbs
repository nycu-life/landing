<article class='native-post-card {{post_class}}'>
	<a href='{{url}}'>
		{{#if feature_image}}<img
				src='{{img_url feature_image size='m'}}'
				alt='{{feature_image_alt}}'
				loading='lazy'
			/>{{/if}}
		<div class='native-post-copy'><time datetime='{{date format='YYYY-MM-DD'}}'>{{date
					format='YYYY / MM / DD'
				}}</time><h2>{{title}}</h2><p>{{excerpt words='35'}}</p>{{tags separator=' / ' autolink='false'}}</div>
	</a>
</article>
