<footer id="prototype-footer" class="prototype-footer">
    <div class="footer-grid">
        <div class="footer-brand">
            <img src="{{asset 'brand/logo-horizontal-white.svg'}}" alt="NYCU LIFE">
            {{#get "pages" filter="slug:theme-[[locale]]-footer" limit="1"}}
                {{#foreach pages}}<div class="footer-editor-content">{{content}}</div>{{/foreach}}
            {{/get}}
        </div>
        <div class="footer-contact"><strong>{{copy 'menu_contact_label'}}</strong>{{#get "pages" filter="slug:theme-[[locale]]-footer" limit="1"}}{{#foreach pages}}<div class="footer-contact-content">{{content}}</div>{{/foreach}}{{/get}}</div>
        <div class="footer-downloads">
            <strong>{{copy 'footer_download_title'}}</strong>
            <div class="store-links">
                <a class="store-link" href="https://play.google.com/store/apps/details?id=one.nycu.life&amp;pcampaignid=web_share" target="_blank" rel="noopener noreferrer" aria-label="{{copy 'footer_download_android'}}">
                    <span class="store-mark" aria-hidden="true">{{> "store-play"}}</span><span class="store-copy"><small>{{copy 'footer_download_android_kicker'}}</small><span>Google Play</span></span>
                </a>
                <a class="store-link" href="https://apps.apple.com/us/app/nycu-life/id6800430694" target="_blank" rel="noopener noreferrer" aria-label="{{copy 'footer_download_ios'}}">
                    <span class="store-mark" aria-hidden="true">{{> "store-apple"}}</span><span class="store-copy"><small>{{copy 'footer_download_ios_kicker'}}</small><span>App Store</span></span>
                </a>
            </div>
        </div>
    </div>
    <div class="footer-bottom"><span>© {{date format="YYYY"}} NYCU LIFE</span><span class="made-with">{{copy 'footer_credit'}} · <a href="https://github.com/nycu-life/landing" target="_blank" rel="noopener noreferrer">{{copy 'footer_source'}}</a></span></div>
</footer>
