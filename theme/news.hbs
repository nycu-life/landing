{{!< default}}
{{#contentFor "lang"}}[[lang]]{{/contentFor}}
{{#contentFor "header"}}{{> "[[locale]]/header"}}{{/contentFor}}
{{#contentFor "footer"}}{{> "[[locale]]/footer"}}{{/contentFor}}
<div class="page devlog-page news-page">
    <header class="page-head"><span class="devlog-eyebrow">NYCU LIFE / NEWS</span><h1 class="page-title">{{copy 'news_title'}}</h1><p class="page-lede">{{copy 'news_lede'}}</p></header>
    <p class="news-follow">{{copy 'news_social_follow'}} <span class="social-profiles"><a href="https://www.instagram.com/nycu.life/" target="_blank" rel="noopener noreferrer">Instagram</a><a href="https://www.threads.com/@nycu.life" target="_blank" rel="noopener noreferrer">Threads</a></span></p>
    {{#if posts}}
    {{!-- A post whose body is only an Instagram or Threads link is shown as the
          official embed (theme/site.js); every other post keeps its card. --}}
    <ol class="news-stream">
        {{#foreach posts}}<li class="news-item" data-news-item>{{> "card"}}<template data-news-content>{{content}}</template></li>{{/foreach}}
    </ol>
    {{pagination}}
    {{else}}
    <section class="collection-empty" aria-labelledby="collection-empty-title">
        <img class="collection-empty-art" src="{{asset 'story/designer/wishpool/machine.svg'}}" alt="" width="180" height="180">
        <div class="collection-empty-copy"><h2 id="collection-empty-title">{{copy 'news_empty_title'}}</h2><p>{{copy 'news_empty_body'}}</p><a class="collection-empty-link" href="https://www.instagram.com/nycu.life/" target="_blank" rel="noopener noreferrer">Instagram <span aria-hidden="true">↗</span></a></div>
    </section>
    {{/if}}
</div>
